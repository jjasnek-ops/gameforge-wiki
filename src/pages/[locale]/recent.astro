---
/**
 * Recent updates — non-default locales: /[locale]/recent
 */
import RecentPage from '~/components/article/RecentPage.astro';
import { defaultLocale, isLocale, locales, type Locale } from '~/i18n/routing';
import { languageAlternates, recentPath } from '~/lib/url';
import { getRecentEntries } from '~/lib/content';

export function getStaticPaths() {
  return locales
    .filter((l) => l !== defaultLocale)
    .map((locale) => ({ params: { locale } }));
}

const localeParam = Astro.params.locale;
if (!isLocale(localeParam) || localeParam === defaultLocale) {
  return new Response('Not Found', { status: 404 });
}
const locale: Locale = localeParam;

const coverage = await Promise.all(locales.map(async loc => ({ loc, count: (await getRecentEntries(loc, 1)).length })));
const coveredLocales = coverage.filter(item => item.count > 0).map(item => item.loc);
const alternates = languageAlternates((loc) => recentPath(loc), coveredLocales);
// Zero published articles = thin empty state — noindex, same treatment as
// ListPage's empty category lists.
const noindex = (await getRecentEntries(locale, 1)).length === 0;
---

<RecentPage locale={locale} alternates={alternates} noindex={noindex} />
