---
/**
 * LegalContent — the shared body for each legal page.
 * Renders different content based on the `page` prop. English only (per PRD).
 */
import { NAVIGATION_CONFIG } from '~/config/navigation';
import { features, gameforgeEnabled } from '~/config/features';
import { getUi } from '~/i18n/ui';
import { defaultLocale } from '~/i18n/routing';
import { site } from '~/config/site';

interface Props {
  page: 'about' | 'privacy-policy' | 'terms-of-service' | 'copyright' | 'contact';
}
const { page } = Astro.props;
const game = site.game.name;
const year = new Date().getFullYear();
const labels = getUi(defaultLocale).nav as Record<string, string>;
---

{gameforgeEnabled && page === 'about' && <>
  <p>{site.description}</p>
  <p>{site.name} is an independent fan reference for {game} on {site.game.platform}. {site.legalNotice}</p>
  <h2>Topics</h2>
  <ul>{NAVIGATION_CONFIG.map(item => <li>{labels[item.key] ?? item.key}</li>)}</ul>
  <h2>Corrections and contact</h2>
  <p>For corrections or questions about this site, use the channels on the <a href="/contact/">contact page</a>.</p>
</>}
{gameforgeEnabled && page === 'contact' && <>
  <p>Contact {site.name} through the channels below.</p>
  <ul>
    {site.contactEmail && <li><a href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a></li>}
    {site.social.discord && <li><a href={site.social.discord} rel="noopener noreferrer">Community chat</a></li>}
    {site.social.youtube && <li><a href={site.social.youtube} rel="noopener noreferrer">Video channel</a></li>}
    {site.social.twitter && <li><a href={site.social.twitter} rel="noopener noreferrer">Social updates</a></li>}
    {site.social.reddit && <li><a href={site.social.reddit} rel="noopener noreferrer">Community discussions</a></li>}
  </ul>
  {!site.contactEmail && !site.social.discord && !site.social.youtube && !site.social.twitter && !site.social.reddit && <p>No public contact channel is currently available.</p>}
  <h2>Official game information</h2><p><a href={site.social.official} rel="noopener noreferrer">Game developer's official website</a>. This is separate from the wiki operator.</p>
</>}
{gameforgeEnabled && page === 'copyright' && <>
  <h2>Editorial material</h2><p>Original editorial material is credited to {site.name} and the respective contributors. Third-party media and quotations retain their owners' rights.</p>
  <h2>Game rights</h2><p>{game} and related trademarks and assets belong to their respective rights holders. This independent fan site claims no ownership of those rights.</p>
  <h2>Software notices</h2><p>The software's original copyright and permission notices are preserved in the <a href="/licenses/site-software.txt">software license</a>. Additional dependency notices accompany the distributed software.</p>
  <h2>Rights requests</h2><p>Use the <a href="/contact/">contact page</a> to report a rights concern with a precise description and the affected URL.</p>
</>}

{
  page === 'about' && !gameforgeEnabled && (
    <>
      <p>
        {site.name} is a fan-made community wiki dedicated to {game}, a {site.game.genre} on{' '}
        {site.game.platform} developed by {site.game.developer}. Our mission is to provide accurate,
        up-to-date guides, tips, and reference material to help players get the most out of the
        game.
      </p>
      <h2>What We Cover</h2>
      <ul>
        <li>Boss strategies and attack patterns</li>
        <li>Item locations, stats, and crafting recipes</li>
        <li>Active redeemable codes (updated daily)</li>
        <li>Tier lists and build recommendations</li>
        <li>Progression guides for new and returning players</li>
      </ul>
      <h2>Community-Driven</h2>
      <p>
        This wiki is maintained by volunteers. If you spot an error or have content to contribute,
        join our Discord and let us know. All content is freely accessible — no account required.
      </p>
      <h2>Contact</h2>
      <p>
        Reach us via our{' '}
        <a href={site.social.discord} target="_blank" rel="noopener noreferrer">
          Discord server
        </a>{' '}
        or{' '}
        <a href={site.social.official} target="_blank" rel="noopener noreferrer">
          the game's official channels
        </a>
        .
      </p>
    </>
  )
}

{
  page === 'privacy-policy' && (
    <>
      <p>
        This privacy policy describes how {site.name} ("we", "us", or "our") handles information
        when you visit this website.
      </p>
      <h2>Information We Collect</h2>
      <p>
        {site.name} is a static website. We do not require you to create an account or submit
        personal information. We do not directly collect or store personal data.
      </p>
      <h2>Third-Party Services</h2>
      <p>
        We use third-party services that may collect information as described in their respective
        privacy policies:
      </p>
      <ul>
        {(!gameforgeEnabled || features.adsense || features.adsterra) && <li>
          <strong>Advertising partners</strong> (e.g. Google AdSense, Adsterra) — may use cookies to
          serve relevant ads. You can opt out of personalized advertising via your browser settings.
        </li>}
        {(!gameforgeEnabled || features.analytics) && <li>
          <strong>Analytics</strong> (e.g. Google Analytics, Cloudflare Web Analytics) — GA may
          collect anonymized usage data such as page views and approximate location (cookie-based,
          loaded only after you accept the consent banner); Cloudflare Web Analytics is cookieless
          and collects aggregate page-view data.
        </li>}
        <li>
          <strong>Cloudflare</strong> — our hosting provider, which may process basic request data
          for security and performance (and serve Web Analytics when enabled, see above).
        </li>
        {(!gameforgeEnabled || features.comments) && <li>
          <strong>Comments</strong> (giscus, opt-in) — when the comment section is enabled,
          giscus.app loads an embedded GitHub view; viewing it exposes your IP address and browser
          info to that service, and signing in to comment is handled by GitHub under its own
          privacy policy.
        </li>}
        {(!gameforgeEnabled || features.advancedVideo) && <li>
          <strong>Embedded videos</strong> (YouTube) — pages with videos load thumbnail images
          from i.ytimg.com and, after you press play, the YouTube player from youtube-nocookie.com.
          Until you interact, no YouTube cookies are set.
        </li>}
      </ul>
      <h2>Cookies</h2>
      <p>
        Some third-party services set cookies. You can control cookies through your browser
        settings. Disabling cookies may affect ad personalization but will not prevent you from
        accessing site content.
      </p>
      <h2>Children's Privacy</h2>
      <p>
        {site.name} is not directed at children under 13, and we do not knowingly collect
        information from children.
      </p>
      <h2>Changes to This Policy</h2>
      <p>We may update this policy from time to time. Changes will be posted on this page.</p>
    </>
  )
}

{
  page === 'terms-of-service' && (
    <>
      <p>By accessing {site.name}, you agree to the following terms of service.</p>
      <h2>Use of Content</h2>
      {gameforgeEnabled && <p>These editorial terms do not replace the separate software licenses and third-party rights listed on the <a href="/copyright/">copyright page</a>.</p>}
      <p>
        All guides, articles, and reference material on this site are provided for personal,
        non-commercial use. You may not copy, republish, or redistribute our content without
        attribution and a link back to the original page.
      </p>
      <h2>Accuracy</h2>
      <p>
        We strive for accuracy but make no warranties regarding the completeness or correctness of
        any content. {game} is frequently updated, and information may become outdated. Always
        verify critical information in-game.
      </p>
      <h2>Third-Party Links</h2>
      <p>
        This site links to external websites (official game channels, video tutorials, etc.) that we
        do not control. We are not responsible for the content or practices of third-party sites.
      </p>
      <h2>Trademarks</h2>
      <p>
        {game} and all related trademarks, logos, and assets are the property of{' '}
        {site.game.developer}. {site.name} is an independent fan project and is not affiliated with
        or endorsed by {site.game.developer}.
      </p>
      <h2>Limitation of Liability</h2>
      <p>
        Use of this site is at your own risk. We are not liable for any damages arising from your
        use of the site or reliance on its content.
      </p>
      <h2>Changes to These Terms</h2>
      <p>
        We may revise these terms at any time. Continued use of the site after changes constitutes
        acceptance of the updated terms.
      </p>
    </>
  )
}

{
  page === 'copyright' && !gameforgeEnabled && (
    <>
      <h2>Copyright Notice</h2>
      <p>
        © {year} {site.name}. All original articles, guides, and written content on this site are
        the intellectual property of {site.name} and its contributors.
      </p>
      <h2>Game Assets</h2>
      <p>
        {game}, including its name, logo, characters, artwork, and other related assets, is the
        property of {site.game.developer}. All {game} content is used on this wiki under fair use
        for the purpose of providing informational guides to players. {site.name} claims no
        ownership of any {game} intellectual property.
      </p>
      <h2>DMCA / Takedown</h2>
      <p>
        If you believe any content on this site infringes your copyright, please contact us via our{' '}
        <a href={site.social.discord} target="_blank" rel="noopener noreferrer">
          Discord server
        </a>{' '}
        with a detailed description of the allegedly infringing material. We will review and respond
        to valid requests promptly.
      </p>
      <h2>Fan-Made Notice</h2>
      <p>{site.legalNotice}</p>
    </>
  )
}

{
  page === 'contact' && !gameforgeEnabled && (
    <>
      {/* h2, not h1 — LegalPage already renders the page H1 (single-H1 rule). */}
      <h2>Contact {site.name}</h2>
      <p>
        {site.name} is a fan-made wiki. Reach us or contribute through any of the channels below.
      </p>
      <h2>Community</h2>
      <ul>
        {site.social.official && (
          <li>
            <strong>Official game website:</strong>{' '}
            <a href={site.social.official} target="_blank" rel="noopener noreferrer">
              {site.social.official}
            </a>
          </li>
        )}
        {site.social.discord && (
          <li>
            <strong>Discord:</strong>{' '}
            <a href={site.social.discord} target="_blank" rel="noopener noreferrer">
              Join our server
            </a>
          </li>
        )}
        {site.social.reddit && (
          <li>
            <strong>Reddit:</strong>{' '}
            <a href={site.social.reddit} target="_blank" rel="noopener noreferrer">
              r/{site.game.name.replace(/\s+/g, '')}
            </a>
          </li>
        )}
        {site.social.youtube && (
          <li>
            <strong>YouTube:</strong>{' '}
            <a href={site.social.youtube} target="_blank" rel="noopener noreferrer">
              {site.name} channel
            </a>
          </li>
        )}
        {site.contactEmail && (
          <li>
            <strong>Email:</strong> <a href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a>
          </li>
        )}
      </ul>
      <h2>Contributing</h2>
      <p>
        Found a typo or outdated info? Want to add a guide? This wiki is open source — submit changes
        via pull requests or through any channel listed above.
      </p>
      <h2>Reporting Issues</h2>
      <p>
        For copyright or takedown requests, see our{' '}
        <a href="/copyright/">Copyright page</a>.
      </p>
    </>
  )
}
